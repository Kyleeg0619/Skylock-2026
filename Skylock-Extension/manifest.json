{
  "name": "Hello Extensions",
  "description": "Base Level Extension",
  "version": "1.0",
  "manifest_version": 3,
  "action": {
    "default_popup": "skylock_tracker.html",
    "default_icon": "images/logo.png",
    "content_scripts": [
      {
        "matches": ["<all_urls>"],
        "js": ["scripts/tracker.js"]
      }
    ],
    "background": {
      "service_worker": "scripts/background.js"
    }
  }
}